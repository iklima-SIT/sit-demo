# Existing SIT runtime configuration
DATABASE_URL=
EXA_API_KEY=

# Optional LLM response layer. The deterministic SIT engine remains the fallback.
SIT_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=15000

# Telegram Bot API. Create the bot with @BotFather and choose the webhook secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Hostinger provides PORT automatically. Use / when deploying at the domain root.
BASE_PATH=/
NODE_ENV=production
