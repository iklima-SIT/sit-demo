# Existing SIT runtime configuration
DATABASE_URL=
EXA_API_KEY=

# Grounded OpenAI response layer. It activates automatically when a key exists.
# Set SIT_LLM_ENABLED=false only when you intentionally want the deterministic fallback.
SIT_LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_PREMIUM_MODEL=gpt-5.6-sol
OPENAI_PREMIUM_REASONING_EFFORT=low
OPENAI_PREMIUM_MAX_OUTPUT_TOKENS=800
SIT_SESSION_TTL_DAYS=3
# Optional: defaults to artifacts/api-server/.data/conversation-sessions.json
# SIT_SESSION_STORE_PATH=/absolute/path/to/conversation-sessions.json
OPENAI_TIMEOUT_MS=15000

# Telegram Bot API. Create the bot with @BotFather and choose the webhook secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Developer-only shadow agent. It never changes the customer-facing response.
SIT_DEVELOPER_MODE_ENABLED=false
SIT_AGENT_SHADOW_ENABLED=false
SIT_AGENT_MODEL=gpt-5.6-sol
SIT_AGENT_REASONING_EFFORT=medium
SIT_AGENT_TIMEOUT_MS=20000

# Hostinger provides PORT automatically. Use / when deploying at the domain root.
BASE_PATH=/
NODE_ENV=production
